<?xml version="1.0"?>
<package format="3">
  <name>supermarket_bringup</name>
  <version>0.1.0</version>
  <description>Launch, map, and parameter assets for the Nav2 candidate stack.</description>
  <maintainer email="team@example.invalid">Supermarket Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
